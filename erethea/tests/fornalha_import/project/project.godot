; Test project for erethea/tests/fornalha_import/test_fornalha_import.py, which
; adds the models and the blockout the way the Fornalha leaves them, builds the
; scenes and walks the player.

config_version=5

[application]

config/name="Erethea Fornalha Import Test"
config/features=PackedStringArray("4.8", "Forward Plus")

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogador"
3d_physics/layer_3="inimigos"

[rendering]

; Chosen on purpose: Erethea's default for new projects is 0.03.
erethea/subsurface_scattering/follow_surface=0.05
