; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Erethea Modern Title Bar Game"
config/description="A tiny game that draws its own title bar. The window test runs it with display/window/erethea/modern_title_bar on and off."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/erethea/modern_title_bar=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
