; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Erethea Hair Strands Test"
config/description="A few hundred strands of hair, as lines, on a sphere that a one-bone skeleton turns. EretheaHairStrands must draw them as ribbons that follow the pose."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=512
window/size/viewport_height=512
window/size/resizable=false
window/vsync/vsync_mode=0
