; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Erethea Assistant Test"
config/description="A small project in which test_assistant.py drives the assistant panel against a fake model server."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor]

erethea_fornalha/build_automatically=false
erethea_fornalha/live_link=false

[editor_plugins]

enabled=PackedStringArray("res://addons/assistant_driver/plugin.cfg")
