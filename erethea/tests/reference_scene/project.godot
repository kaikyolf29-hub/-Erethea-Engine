; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Erethea Reference Scene"
config/description="A village, a forest and a character, by day and by night, built from code. Used to compare the look and speed of Erethea with stock Godot."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0
