#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_erethea_post = env_modules.Clone()

if env["rendering_device"]:
    env_erethea_post.RD_GLSL("erethea_post_effect.glsl")
    env_erethea_post.RD_GLSL("erethea_motion_blur.glsl")
    env_erethea_post.RD_GLSL("erethea_lens_flare.glsl")
    env_erethea_post.Depends(Glob("*.glsl.gen.h"), ["#glsl_builders.py"])

module_obj = []

env_erethea_post.add_source_files(module_obj, "*.cpp")
if env.editor_build:
    env_erethea_post.add_source_files(module_obj, "editor/*.cpp")

env.modules_sources += module_obj
